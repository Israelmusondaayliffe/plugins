{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-film-studio/FixPacket/v1",
  "title": "FixPacket",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "audit_packet_id", "role", "model", "effort", "fresh_task", "forked", "thread_id", "accepted_finding_ids", "allowed_write_paths", "inputs", "expected_outputs", "repair_round", "status", "authority"],
  "properties": {
    "schema_version": {"const": "ai-film-studio/FixPacket/v1"},
    "id": {"type": "string", "pattern": "^fix_[a-z0-9_]+$"},
    "audit_packet_id": {"type": "string", "pattern": "^audit_[a-z0-9_]+$"},
    "role": {"const": "fixer"}, "model": {"const": "gpt-5.6-sol"}, "effort": {"const": "xhigh"}, "fresh_task": {"const": true}, "forked": {"const": false},
    "thread_id": {"type": "string", "minLength": 1},
    "accepted_finding_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "allowed_write_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "inputs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "expected_outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "repair_round": {"const": 1},
    "status": {"enum": ["proposed", "applied", "failed"]},
    "authority": {"type": "object", "required": ["may_write", "may_approve", "may_integrate", "may_issue_final_verdict"], "properties": {"may_write": {"const": true}, "may_approve": {"const": false}, "may_integrate": {"const": false}, "may_issue_final_verdict": {"const": false}}}
  }
}
