{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-film-studio/delivery-record/v1",
  "title": "DeliveryRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "project_id", "status", "source_records", "acceptance_criteria", "external_delivery"],
  "properties": {
    "schema_version": {"const": "ai-film-studio/delivery-record/v1"},
    "id": {"type": "string", "pattern": "^delivery_[a-z0-9_]+$"},
    "project_id": {"type": "string", "pattern": "^project_[a-z0-9_]+$"},
    "status": {"enum": ["draft", "ready_for_review", "approved_for_external_delivery", "delivered"]},
    "source_records": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "external_delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "approval_id"],
      "properties": {"required": {"type": "boolean"}, "approval_id": {"type": "string"}}
    }
  }
}
