{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-film-studio/ModelProfile/v1",
  "title": "ModelProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_version", "model_id", "model_version_checked", "verified_at", "selection_policy", "status", "prompt_formatter", "validator", "supported_inputs", "reference_support", "audio_support", "duration_support", "editing_modes", "known_constraints", "failure_patterns", "first_party_evidence", "preflight", "external_action_policy"],
  "properties": {
    "schema_version": {"const": "ai-film-studio/ModelProfile/v1"},
    "profile_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "model_id": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
    "model_version_checked": {"type": "string", "minLength": 1},
    "verified_at": {"type": "string", "minLength": 1},
    "selection_policy": {"enum": ["default-delegation", "explicit-only", "template-only"]},
    "status": {"enum": ["delegated", "unverified", "template"]},
    "prompt_formatter": {"type": "string", "minLength": 1},
    "validator": {"type": "string", "minLength": 1},
    "supported_inputs": {"type": "array", "items": {"type": "string"}},
    "reference_support": {"type": "array", "items": {"type": "string"}},
    "audio_support": {"type": "string"},
    "duration_support": {"type": "string"},
    "editing_modes": {"type": "array", "items": {"type": "string"}},
    "known_constraints": {"type": "array", "items": {"type": "string"}},
    "failure_patterns": {"type": "array", "items": {"type": "string"}},
    "first_party_evidence": {"type": "array", "items": {"type": "string"}},
    "preflight": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "external_action_policy": {"const": "approval-required"}
  }
}
