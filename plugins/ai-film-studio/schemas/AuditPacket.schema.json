{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-film-studio/AuditPacket/v1",
  "title": "AuditPacket",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "role", "model", "effort", "fresh_task", "forked", "thread_id", "dependencies", "target_artifacts", "status", "checks", "findings", "authority"],
  "properties": {
    "schema_version": {"const": "ai-film-studio/AuditPacket/v1"},
    "id": {"type": "string", "pattern": "^audit_[a-z0-9_]+$"},
    "role": {"const": "auditor"}, "model": {"const": "gpt-5.6-sol"}, "effort": {"const": "xhigh"}, "fresh_task": {"const": true}, "forked": {"const": false},
    "thread_id": {"type": "string", "minLength": 1},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "target_artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "status": {"enum": ["draft", "complete"]},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "findings": {"type": "array", "items": {"type": "object", "required": ["id", "severity", "evidence", "accepted"], "properties": {"id": {"type": "string"}, "severity": {"enum": ["info", "minor", "major", "blocker"]}, "evidence": {"type": "string"}, "accepted": {"type": "boolean"}}}},
    "authority": {"type": "object", "required": ["may_write", "may_approve", "may_integrate", "may_issue_final_verdict"], "properties": {"may_write": {"const": false}, "may_approve": {"const": false}, "may_integrate": {"const": false}, "may_issue_final_verdict": {"const": false}}}
  }
}
