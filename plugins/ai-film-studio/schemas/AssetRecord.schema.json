{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-film-studio/AssetRecord/v1",
  "title": "AssetRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "project_id", "type", "version", "state", "status", "descriptor", "positive_reference_scope", "negative_reference_scope", "source_files", "continuity_relationships", "proof"],
  "properties": {
    "schema_version": {"const": "ai-film-studio/AssetRecord/v1"},
    "id": {"type": "string", "pattern": "^@(char|loc|prop|costume|voice)_[a-z0-9_]+$"},
    "project_id": {"type": "string", "pattern": "^project_[a-z0-9_]+$"},
    "type": {"enum": ["character", "location", "prop", "costume", "voice"]},
    "version": {"type": "integer", "minimum": 1},
    "state": {"type": "string", "minLength": 1},
    "status": {"enum": ["candidate", "proofing", "approved", "held", "retired"]},
    "descriptor": {"type": "string", "minLength": 1},
    "positive_reference_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "negative_reference_scope": {"type": "array", "items": {"type": "string"}},
    "source_files": {"type": "array", "items": {"type": "object", "required": ["path", "sha256", "rights_status"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "rights_status": {"type": "string"}}}},
    "continuity_relationships": {"type": "object", "required": ["parent_asset_id", "related_asset_ids"], "properties": {"parent_asset_id": {"type": "string"}, "related_asset_ids": {"type": "array", "items": {"type": "string"}}}},
    "proof": {"type": "object", "required": ["status", "conditions", "evidence_paths"], "properties": {"status": {"enum": ["unrun", "passed", "failed", "held"]}, "conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "evidence_paths": {"type": "array", "items": {"type": "string"}}}}
  }
}
